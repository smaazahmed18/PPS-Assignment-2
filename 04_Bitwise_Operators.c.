#include <stdio.h>
#include <string.h>
#include <math.h>
#include <stdlib.h>
//Complete the following function.


void calculate_the_maximum(int n, int k) {
  int max_and = 0;
    int max_or = 0;
    int max_xor = 0;

    for (int i = 1; i <= n; i++)
    {
        for (int j = i + 1; j <= n; j++)
        {
            int andValue = i & j;
            int orValue = i | j;
            int xorValue = i ^ j;

            if (andValue < k && andValue > max_and)
                max_and = andValue;

            if (orValue < k && orValue > max_or)
                max_or = orValue;

            if (xorValue < k && xorValue > max_xor)
                max_xor = xorValue;
        }
    }

    printf("%d\n", max_and);
    printf("%d\n", max_or);
    printf("%d\n", max_xor);
}

int main() {
    int n, k;
  
    scanf("%d %d", &n, &k);
    calculate_the_maximum(n, k);
 
    return 0;
}
